      "source": [
        "import pandas as pd\n",
        "path = 'https://raw.githubusercontent.com/lab30041954/Data/main/'\n",
        "df = pd.read_csv(path + 'spam.csv')\n",
        "df.head()"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "round(df['spam'].mean(), 3)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "PGNTJ2cuqJ-y",
        "outputId": "6277b2ab-e312-434b-d4aa-e0f2bc232afd"
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "np.float64(0.394)"
            ]
          },
          "metadata": {},
          "execution_count": 3
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "We create a target vector and a features matrix."
      ],
      "metadata": {
        "id": "C32rfKjSr6ZI"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "y = df['spam']\n",
        "X = df.drop(columns='spam')"
      ],
      "metadata": {
        "id": "wFvYnsMTsMJl"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "rR7-3S9AoVA4"
      },
      "source": [
        "### Construct a modified feature matrix"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "L70MIvaLoVA4"
      },
      "source": [
        "(a) dropping the three cap_ features"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "metadata": {
        "id": "_noon52BoVA4"
      },
      "outputs": [],
      "source": [
        "X_new = X.drop(columns=[c for c in X.columns if c.startswith('cap_')])"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "(b) binarizing all the word_ features, transforming every column into a dummy for the occurrence of the corresponding word, taking value 1 if the word occurs in the message and 0 otherwise"
      ],
      "metadata": {
        "id": "Uc33pQ7nsu__"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "word_cols = [c for c in X_new.columns if c.startswith('word_')]\n",
        "X_new[word_cols] = (X_new[word_cols] > 0).astype(int)"
      ],
      "metadata": {
        "id": "cuBMWixqs5v_"
      },
      "execution_count": 6,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "I inspect the first few rows of the modified feature matrix to verify that everything is correct."
